# Salin berkas ini menjadi infra/.env lalu ganti nilainya.
# infra/.env tidak ikut ke Git (lihat .gitignore).
# Dipakai oleh docker compose dan oleh aplikasi saat dijalankan dari IDE.

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=ganti-admin-lokal

CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=ganti-catalog-lokal

ORDER_DB_USER=orders
ORDER_DB_PASSWORD=ganti-orders-lokal

PRICING_CLIENT_SECRET=ganti-pricing-lokal
