{
  "request": {
    "method": "POST",
    "urlPath": "/oauth/token"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"access_token\": \"{{randomValue length=32 type='ALPHANUMERIC'}}\", \"token_type\": \"Bearer\", \"expires_in\": @TOKEN_TTL_SECONDS@}",
    "delayDistribution": {
      "type": "lognormal",
      "median": @TOKEN_MEDIAN_MS@,
      "sigma": @TOKEN_SIGMA@
    }
  }
}
