      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(hikaricp_connections_acquire_milliseconds_bucket{service_name=~\"$service\"}[1m])))",
          "legendFormat": "{{service_name}} acquire p99",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(hikaricp_connections_usage_milliseconds_bucket{service_name=~\"$service\"}[1m])))",
          "legendFormat": "{{service_name}} usage p99",
          "refId": "B"
        }
      ]
    },
    {
