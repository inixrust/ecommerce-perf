          "expr": "histogram_quantile(0.99, sum by (le, service_name, client_name, uri) (rate(http_client_requests_milliseconds_bucket{service_name=~\"$service\"}[1m])))",
          "legendFormat": "{{service_name}} -> {{client_name}} {{uri}}",
          "refId": "A"
        }
