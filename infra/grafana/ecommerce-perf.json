        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_pending{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}} menunggu",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_max{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}} maks",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Waktu menunggu koneksi (p99) dan lama koneksi dipakai (p99)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
